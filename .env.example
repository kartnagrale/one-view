# AGRI-ANALYTIX v2
AGRI_DEMO_MODE=true
AGRI_REFRESH_MS=900000
AGRI_HISTORY_START=2022-04-01
AGRI_REFRESH_LOOKBACK_DAYS=14
AGRI_MAPPING_SCHEMA=agri_analytix
AGRI_MAPPING_AUTO_INIT=true

# Local/demo authentication. Change all passwords before any shared deployment.
AGRI_INTERNAL_USER=analyst
AGRI_INTERNAL_PASSWORD=demo123
AGRI_MARKETWATCH_USER=marketwatch
AGRI_MARKETWATCH_PASSWORD=demo123

# 1) https://market.neml.in/
# One physical PostgreSQL DB. The application reads auctionv2replica and
# participant-masterv2_replica and writes only its own agri_analytix mapping schema.
MASTER_DB_ENABLED=false
MASTER_DB_URL=jdbc:postgresql://HOST:5432/DB?currentSchema=auctionv2replica
MASTER_DB_USER=
MASTER_DB_PASSWORD=
MASTER_DB_POOL_SIZE=1
MASTER_DB_READ_ONLY=false

# 2) https://sugar.neml.in/SpotLite/ -> sugarpgprd
SUGAR_DB_ENABLED=false
SUGAR_DB_URL=jdbc:postgresql://HOST:5432/DB?currentSchema=sugarpgprd
SUGAR_DB_USER=
SUGAR_DB_PASSWORD=
SUGAR_DB_POOL_SIZE=1

# 3) https://members.ncdfiemarket.com/SpotLite/ -> ncdfiprd21
NCDFI_DB_ENABLED=false
NCDFI_DB_URL=jdbc:postgresql://HOST:5432/DB?currentSchema=ncdfiprd21
NCDFI_DB_USER=
NCDFI_DB_PASSWORD=
NCDFI_DB_POOL_SIZE=1
